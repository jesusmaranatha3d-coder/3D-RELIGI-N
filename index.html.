async function importCopy(file){
  if(!file)return;
  try{
    if(!/\.json$/i.test(file.name)){modal('<h2>Archivo no compatible</h2><p>Selecciona una copia de Guardianes del Corazón en formato <strong>.json</strong>.</p>');return}
    const text=await file.text();
    let incoming;
    try{incoming=JSON.parse(text)}catch{incoming=null}
    if(!incoming||typeof incoming!=='object'||Array.isArray(incoming)){modal('<h2>No se pudo importar</h2><p>El archivo JSON no tiene un formato válido.</p>');return}
    if(incoming.app&&incoming.app!=='guardianes-del-corazon'){modal('<h2>Archivo no compatible</h2><p>Este JSON no pertenece a Guardianes del Corazón.</p>');return}
    const importedCustom=sanitizeCustom(incoming.custom);
    const importedProgress=validProgress(incoming.progress);
    const hasCustom=Object.keys(importedCustom).length>0;
    if(!hasCustom&&!importedProgress){modal('<h2>Copia sin cambios</h2><p>El archivo es compatible, pero no contiene personalizaciones ni una partida guardada para importar.</p>');return}
    window.__pendingImport={custom:importedCustom,progress:importedProgress,fileName:file.name};
    modal(`<h2>Importar esta copia JSON</h2><p>Se encontró una copia válida: <strong>${esc(file.name)}</strong>.</p><p>Al importar, sus personalizaciones${importedProgress?' y su progreso de partida':''} reemplazarán los datos guardados actualmente en este navegador.</p><div class="row">${btn('Importar y continuar','applyImport()','primary')}${btn('Cancelar',"document.querySelector('#modal').close()")}</div>`);
  }catch(e){modal('<h2>No se pudo importar</h2><p>No fue posible leer el archivo. Comprueba que sea un JSON exportado desde este juego.</p>')}
}
function applyImport(){
  const incoming=window.__pendingImport;if(!incoming)return;
  try{
    const previous=localStorage.getItem(CUSTOM_KEY);if(previous)localStorage.setItem(CUSTOM_BACKUP_KEY,previous);
    localStorage.setItem(CUSTOM_KEY,JSON.stringify(incoming.custom||{}));
    localStorage.setItem(CUSTOM_DRAFT_KEY,JSON.stringify(incoming.custom||{}));
    if(incoming.progress)localStorage.setItem(KEY,JSON.stringify(incoming.progress));else localStorage.removeItem(KEY);
    custom=JSON.parse(JSON.stringify(incoming.custom||{}));
    draft=JSON.parse(JSON.stringify(custom));
    s=incoming.progress?JSON.parse(JSON.stringify(incoming.progress)):null;
    window.__pendingImport=null;
    document.querySelector('#modal').close();
    home();
    setTimeout(()=>modal(`<h2>✓ Copia JSON importada</h2><p>Las modificaciones${s?' y el progreso':''} ya están cargadas en esta computadora.</p><p>Puedes seguir editando y después usar <strong>Exportar copia (.json)</strong> para guardar el trabajo actualizado en tu USB.</p>`),50);
  }catch(e){modal('<h2>No se pudo completar la importación</h2><p>El navegador no permitió guardar los datos importados. Comprueba que el almacenamiento local esté habilitado.</p>')}
}

function exportCopy(){
  try{
    if(document.querySelector('#edit-title')){persistDraft();saveCustom(false)}
    const snapshot={
      app:'guardianes-del-corazon',
      version:1,
      exportedAt:new Date().toISOString(),
      custom:JSON.parse(JSON.stringify(custom||{})),
      progress:s?JSON.parse(JSON.stringify(s)):null
    };
    const json=JSON.stringify(snapshot,null,2);
    const blob=new Blob([json],{type:'application/json;charset=utf-8'});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');
    const stamp=new Date().toISOString().replace(/[:.]/g,'-').slice(0,19);
    a.href=url;a.download='guardianes-copia-'+stamp+'.json';
    document.body.appendChild(a);a.click();a.remove();
    setTimeout(()=>URL.revokeObjectURL(url),1500);
    modal('<h2>✓ Copia JSON creada</h2><p>Se descargó un archivo <strong>.json</strong> con tus modificaciones y el progreso de la partida.</p><p>Puedes guardarlo en un USB. En otra computadora abre este juego, pulsa <strong>📥 Importar copia (.json)</strong> y selecciona el archivo.</p><p><small>El archivo JSON contiene los datos del juego; para usarlo necesitas conservar también este archivo HTML.</small></p>');
  }catch(e){modal('<h2>No se pudo exportar</h2><p>Prueba nuevamente. Si el navegador bloquea las descargas, autorízalas para esta página.</p>')}
}

home();
