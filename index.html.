async function uploadRegionImage(file){
  if(!file)return;
  const status=document.querySelector('#edit-status');
  if(!['image/png','image/jpeg','image/webp'].includes(file.type)||file.size>10*1024*1024){if(status)status.textContent='Elige una imagen PNG, JPG o WebP de hasta 10 MB.';return}
