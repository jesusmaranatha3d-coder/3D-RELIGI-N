  try{
    url=URL.createObjectURL(file);const img=new Image();img.src=url;await img.decode();
    const scale=Math.min(1,800/img.width,800/img.height);const canvas=document.createElement('canvas');
    canvas.width=Math.max(1,Math.round(img.width*scale));canvas.height=Math.max(1,Math.round(img.height*scale));
    const ctx=canvas.getContext('2d');ctx.fillStyle='#132139';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.drawImage(img,0,0,canvas.width,canvas.height);
