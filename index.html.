  const saveBtn=document.querySelector('#save-custom');const regionSel=document.querySelector('#edit-region');
  if(saveBtn)saveBtn.disabled=true;if(regionSel)regionSel.disabled=true;if(status)status.textContent='Preparando imagen…';
