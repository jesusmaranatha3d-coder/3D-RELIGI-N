function collectEditor(){
  const title=document.querySelector('#edit-title');
  if(!title)return;
  const prev=regionContent(editorIndex,draft);
  const positions=[0,1,2].map(n=>Number(document.querySelector('#edit-position-'+n).value));
  let correctOrder=[0,1,2];
  if(new Set(positions).size===3&&positions.every(n=>n>=0&&n<=2)){
    correctOrder=[0,1,2].map(position=>positions.indexOf(position));
  }
  draft[editorIndex]={
    ...prev,
    title:title.value,
    text:document.querySelector('#edit-text').value,
    description:document.querySelector('#edit-description').value,
    steps:[0,1,2].map(n=>document.querySelector('#edit-step-'+n).value),
    correctOrder,
