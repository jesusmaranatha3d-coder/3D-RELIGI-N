<!doctype html><html lang="es"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Guardianes del Corazón</title>
<style>

:root{color-scheme:dark;--gold:#edc578;--muted:#a9b6ce;--bg:#0b1224}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 75% 10%,#253454,transparent 55%),var(--bg);color:#f5f3ee;font:16px/1.6 system-ui,sans-serif;min-height:100vh}button,input,select,textarea{font:inherit}button{cursor:pointer;border:1px solid #56647d;background:#1d2b43;color:inherit;border-radius:12px;padding:12px 19px;transition:transform .15s,background .15s}button:hover:not(:disabled){background:#30445e;transform:translateY(-2px)}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid var(--gold);outline-offset:4px}button:disabled{opacity:.45;cursor:default}.primary{background:var(--gold);color:#1c2030;border-color:var(--gold);font-weight:750}.primary:hover:not(:disabled){background:#ffe0a4}header{max-width:1180px;margin:auto;padding:24px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff18;gap:15px}.brand{font-weight:800;letter-spacing:.07em;font-size:13px}.brand span{color:var(--gold);margin-right:10px}.tools{display:flex;gap:8px}main{max-width:1180px;margin:auto;padding:32px 24px 60px}.eyebrow{color:var(--gold);font-size:12px;font-weight:800;letter-spacing:.2em;text-transform:uppercase}h1,h2,h3,p{margin-top:0}h1{font-family:Georgia,serif;font-size:clamp(44px,6.8vw,86px);line-height:1.05;font-weight:500;letter-spacing:-.04em;margin:20px 0}h2{font:500 clamp(30px,4vw,48px)/1.1 Georgia,serif;margin-bottom:20px}h3{font-size:20px}.muted,small{color:var(--muted)}.hero{display:grid;grid-template-columns:1.15fr 1fr;gap:50px;align-items:center;min-height:580px}.hero p{max-width:510px}.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}.art{position:relative;aspect-ratio:1;display:grid;place-items:center;background:radial-gradient(circle,#e6be6c20,transparent 62%)}.ring{position:absolute;border:1px solid #edc57833;border-radius:50%;width:90%;height:90%}.ring:after{content:'';position:absolute;inset:28px;border:1px dashed #edc57840;border-radius:50%}.sigil{font-size:150px;color:#f4d493;filter:drop-shadow(0 0 35px #edc57855)}.star{position:absolute;left:calc(50% + var(--x));top:calc(50% + var(--y));font-size:27px;color:var(--gold);text-shadow:0 0 25px #edc578}.card{border:1px solid #ffffff22;border-radius:20px;background:linear-gradient(140deg,#243149b0,#121d32e8);padding:25px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}.region{text-align:left;min-height:210px;position:relative;overflow:hidden}.region .icon{display:block;font-size:40px;margin-bottom:16px}.region strong{display:block;font-size:19px}.region small{display:block}.region.done{border-color:#85cfb0}.region.available{border-color:var(--gold)}.stats{display:flex;flex-wrap:wrap;gap:20px;padding:15px 20px;background:#ffffff08;border:1px solid #ffffff14;border-radius:15px;margin-bottom:30px;font-size:14px}.split{display:grid;grid-template-columns:1fr 1.1fr;gap:26px}.portrait{font-size:110px;text-align:center;padding:30px 0}.options{display:grid;gap:10px;margin-top:22px}.options button{text-align:left}.feedback{padding:16px;border-left:3px solid var(--gold);background:#edc57812;margin:20px 0}.bar{height:12px;background:#080f20;border-radius:10px;overflow:hidden;margin:10px 0 20px}.bar i{display:block;height:100%;background:linear-gradient(90deg,#cb8d67,var(--gold));transition:width .3s}.narrow{max-width:720px;margin:30px auto}label{display:block;margin-bottom:12px}input,select,textarea{display:block;width:100%;background:#0c172a;border:1px solid #56647d;border-radius:10px;padding:13px;color:white;margin:8px 0 20px}footer{color:var(--muted);font-size:12px;margin-top:32px}dialog{background:#132139;color:#f5f3ee;border:1px solid #68718a;border-radius:20px;max-width:620px;padding:30px}dialog::backdrop{background:#000a}.pill{padding:5px 10px;background:#edc57815;color:var(--gold);border-radius:30px;font-size:12px}.trail{display:flex;gap:8px;margin:20px 0}.trail span{height:5px;flex:1;background:#ffffff18}.trail .lit{background:var(--gold)}@media(max-width:720px){.hero,.split{grid-template-columns:1fr}.hero{gap:0}.art{max-width:280px;width:100%;margin:auto;grid-row:1}.sigil{font-size:90px}header{padding:16px}.brand{font-size:11px}main{padding:22px 16px}.tools button{padding:8px}.stats{gap:12px}.hero h1{font-size:46px}.grid{grid-template-columns:1fr 1fr}.region{padding:16px}.region strong{font-size:16px}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}
.region-image{display:block;width:100%;height:135px;object-fit:cover;border-radius:12px;margin:16px 0}.scene-image{display:block;width:100%;max-height:310px;object-fit:cover;border-radius:14px;margin-bottom:20px}.editor-preview{width:100%;max-height:210px;object-fit:contain;border-radius:12px;background:#0b1224}.editor-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}dialog:has(.editor-grid){width:850px;max-width:calc(100vw - 28px)}.tools{flex-wrap:wrap}#edit-status{min-height:28px;color:var(--gold)}@media(max-width:720px){header{flex-wrap:wrap}.editor-grid{grid-template-columns:1fr}.region-image{height:100px}} </style><header><div class="brand"><span>✦</span> GUARDIANES DEL CORAZÓN</div><div class="tools"><button id="customize" onclick="openEditor()">✎ Personalizar</button><button id="export-copy" onclick="exportCopy()">💾 Exportar copia (.json)</button><button id="import-copy" onclick="chooseImport()">📥 Importar copia (.json)</button><input id="import-file" type="file" accept=".json,application/json" hidden onchange="importCopy(this.files[0]);this.value=''"><button id="sound" aria-label="Activar sonido">♫ Sonido: no</button><button id="help">Cómo jugar</button></div></header><main id="app"></main><dialog id="modal"><div id="modalbody"></div><button onclick="document.querySelector('dialog').close()">Cerrar</button></dialog>
<script id="portable-data" type="application/json">{"custom":{},"progress":null}</script>
<script>
const worlds=[
{sin:'Soberbia',virtue:'Humildad',name:'Palacio del Espejo',boss:'Rex Superbia',icon:'♜',desc:'La soberbia nos lleva a creernos superiores y rechazar correcciones. La humildad permite reconocer el propio valor y aprender de otros.',quote:'¿Admitir un error? ¡Que crean que siempre tienes razón!',situations:[['Tu equipo encuentra un error en tu presentación.','Agradecer la corrección y revisar juntos.','Ocultar el error y culpar al equipo.','Escuchar una corrección te ayuda a crecer.'],['Una compañera gana el concurso.','Reconocer su esfuerzo y aprender de ella.','Decir que el jurado no sabe nada.','Reconocer los talentos ajenos no disminuye los tuyos.'],['Te felicitan por una tarea grupal.','Reconocer el aporte de todo el grupo.','Aceptar todo el mérito para ti.','La humildad hace visible el trabajo de los demás.']],steps:['Escuchar la corrección','Reconocer el error','Reparar y aprender']},
{sin:'Avaricia',virtue:'Generosidad',name:'Minas del Oro Eterno',boss:'Avarus',icon:'◈',desc:'La avaricia es el apego excesivo a las posesiones. La generosidad ayuda a compartir responsablemente, sin comprar el afecto de nadie.',quote:'¡Guárdalo todo! Compartir te dejará sin nada.',situations:[['Tienes materiales de sobra y alguien olvidó los suyos.','Prestar lo que puedes y acordar su devolución.','Negarte solo por tener más que los demás.','Compartir responsablemente permite que todos participen.'],['Tu clase reúne útiles para otras familias.','Aportar algo útil según tus posibilidades.','Dar únicamente objetos que ya no sirven.','La generosidad atiende la necesidad real del otro.'],['Un amigo necesita ayuda con una tarea.','Explicarle lo que sabes sin exigir un premio.','Ayudar solo si te regala algo.','Ayudar libremente fortalece la amistad.']],steps:['Reconocer una necesidad','Ver qué puedo compartir','Ofrecer ayuda con respeto']},
{sin:'Lujuria',virtue:'Castidad y respeto',name:'Jardín de las Apariencias',boss:'Speculum',icon:'❀',desc:'La lujuria separa el deseo del respeto a la dignidad de la persona. La castidad integra los afectos con el respeto, el dominio de sí y el cuidado de los límites personales.',quote:'La apariencia es lo único que importa.',situations:[['En el chat comparten una foto de alguien sin permiso.','No reenviarla y pedir que respeten su privacidad.','Difundirla para conseguir reacciones.','La privacidad y el consentimiento merecen respeto.'],['Se burlan del cuerpo de un compañero.','Frenar la burla y ofrecerle apoyo.','Sumarte para encajar con el grupo.','Nadie pierde su dignidad por su apariencia.'],['Una amistad te presiona para algo que no quieres.','Expresar tu límite y buscar apoyo si insiste.','Aceptar aunque te incomode.','Tus límites y los de los demás deben ser respetados.']],steps:['Reconocer la dignidad de la persona','Respetar sus límites','Actuar sin presionar ni difundir imágenes']},
{sin:'Ira',virtue:'Paciencia',name:'Volcán de la Furia',boss:'Ignis',icon:'♨',desc:'Sentir enojo no es lo mismo que actuar con ira. La paciencia y la mansedumbre permiten responder con firmeza sin insultos, violencia ni venganza.',quote:'¡Devuelve el insulto! ¡Haz que se arrepienta!',situations:[['Te provocan después de perder un partido.','Respirar y responder sin insultos.','Empujar a quien te provoca.','Una pausa permite elegir cómo responder.'],['Un mensaje ofensivo aparece en el grupo.','Evitar responder en caliente y pedir respeto.','Publicar otro insulto más fuerte.','Poner límites con calma puede detener el conflicto.'],['Un compañero rompe por accidente tu material.','Explicar tu molestia y buscar una reparación.','Romper sus cosas para vengarte.','La paciencia permite pedir una reparación justa.']],steps:['Hacer una pausa','Expresar la molestia sin agredir','Buscar una solución justa']},
{sin:'Gula',virtue:'Templanza',name:'Valle de los Excesos',boss:'Vorax',icon:'☾',desc:'La gula se refiere al exceso al comer o beber. Aquí también practicamos la templanza ante otros excesos, como el uso del celular, para cuidar el descanso y la libertad de elegir.',quote:'Una más… ¡nunca es suficiente!',situations:[['Llevas horas jugando y necesitas dormir.','Guardar la partida y respetar tu descanso.','Seguir toda la noche aunque estés agotado.','Disfrutar con límites cuida tu salud y tus responsabilidades.'],['Durante una comida miras el celular sin parar.','Apartarlo un rato para conversar.','Ignorar a todos hasta terminar de mirar las redes.','La templanza ayuda a prestar atención a lo que eliges cuidar.'],['Quieres comprar por impulso algo que no necesitas.','Esperar y revisar si realmente te hace falta.','Comprarlo inmediatamente por la emoción.','Una pausa ayuda a decidir con libertad.']],steps:['Reconocer el exceso','Elegir un límite realista','Respetar el límite y descansar']},
{sin:'Envidia',virtue:'Caridad y gratitud',name:'Pantano de las Comparaciones',boss:'Invidia',icon:'♧',desc:'La envidia se entristece por el bien ajeno. La caridad nos invita a alegrarnos por otros; la gratitud ayuda a reconocer nuestros propios dones.',quote:'Mira lo que tiene… ¡debería ser tuyo!',situations:[['Tu amiga obtiene la nota que tú querías.','Felicitarla y revisar cómo mejorar tu estudio.','Inventar que hizo trampa.','Alegrarte por ella es compatible con querer mejorar.'],['Un compañero tiene más seguidores.','Valorar tu vida sin reducirla a números.','Publicar rumores para quitarle popularidad.','Tu valor no depende de una comparación en redes.'],['Eligen a otra persona para liderar.','Apoyar al equipo y desarrollar tus habilidades.','Sabotear su trabajo para que fracase.','Buscar el bien del equipo fortalece la caridad.']],steps:['Reconocer la comparación','Agradecer mis propios dones','Celebrar el bien del otro']},
{sin:'Pereza',virtue:'Diligencia',name:'Torre de la Indiferencia',boss:'Acedia',icon:'⌛',desc:'La pereza evita de forma habitual el esfuerzo y los compromisos. La diligencia da pasos concretos. Descansar, enfermar o necesitar ayuda no equivale a pereza.',quote:'Déjalo para mañana. Tu esfuerzo no importa.',situations:[['Tu parte del trabajo grupal vence mañana.','Empezar por una tarea pequeña y avisar del avance.','Dejar que los demás hagan tu parte sin avisar.','Un primer paso concreto ayuda a cumplir los compromisos.'],['Prometiste colaborar en casa.','Organizar un momento para cumplir lo acordado.','Esperar a que alguien lo haga por ti.','La diligencia convierte una buena intención en acción.'],['Una tarea parece demasiado difícil.','Dividirla en pasos y pedir ayuda si la necesitas.','Abandonarla sin intentar ni pedir apoyo.','Pedir ayuda también es una forma responsable de avanzar.']],steps:['Elegir una tarea concreta','Dividirla en un primer paso posible','Empezar y revisar el avance']}
];
const heroes=[['Fortaleza','♜','Bloquea un error por región.'],['Sabiduría','✧','Descarta una respuesta incorrecta por región.'],['Esperanza','☀','Recupera un corazón una vez por partida.'],['Caridad','♡','Gana 5 puntos extra por decisión acertada.']];
const KEY='guardianes-v1';
function portableSnapshot(){try{const el=document.querySelector('#portable-data');const d=el?JSON.parse(el.textContent||'{}'):{};return d&&typeof d==='object'?d:{}}catch{return {}}}
const PORTABLE=portableSnapshot();
let s=null,level=0,stage=0,hp=300,shield=false,used=false,chosen=[],question=null,action='attack',sound=false;
const app=document.querySelector('#app');const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const btn=(t,fn,cls='')=>`<button class="${cls}" onclick="${fn}">${t}</button>`;
function save(){try{localStorage.setItem(KEY,JSON.stringify(s))}catch{}}
function validProgress(v){return v&&Array.isArray(v.gems)&&Number.isFinite(v.hearts)?v:null}
function load(){try{const v=JSON.parse(localStorage.getItem(KEY));if(validProgress(v))return v}catch{}return validProgress(PORTABLE.progress)}
function tone(){if(!sound)return;try{const c=new(window.AudioContext||window.webkitAudioContext)(),o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);o.frequency.value=660;g.gain.setValueAtTime(.04,c.currentTime);g.gain.exponentialRampToValueAtTime(.001,c.currentTime+.25);o.start();o.stop(c.currentTime+.25);o.onended=()=>c.close()}catch{}}
function modal(t){document.querySelector('#modalbody').innerHTML=t;document.querySelector('#modal').showModal()}
document.querySelector('#help').onclick=()=>modal('<h2>Tu aventura</h2><p>Elige un guardián, explora los tres encuentros de cada región y disipa al jefe. Usa el ratón, el dedo o Tab y Enter.</p><p>Ordena acciones, toma decisiones y elige virtudes. Atacar cuesta 10 de energía y hace 100 de daño al acertar; una virtud cuesta 20 y hace 150. Defender recupera 30 de energía y prepara un escudo.</p><p>Los errores permiten volver a intentar. Si pierdes todos los corazones, reinicia la región. Compra un corazón con 20 monedas. Tu progreso se guarda en este navegador cuando el almacenamiento está disponible.</p>');
document.querySelector('#sound').onclick=()=>{sound=!sound;document.querySelector('#sound').textContent='♫ Sonido: '+(sound?'sí':'no');tone()};
function stats(){return `<div class="stats"><span>♡ ${s.hearts}/5 vidas</span><span>ϟ ${s.energy} energía</span><span>✦ ${s.points} virtud</span><span>◉ ${s.coins} monedas</span><span>◈ ${s.gems.length}/7 gemas</span><span>🧪 ${s.potions} ayudas</span><span>${esc(s.name)} · ${heroes[s.hero][0]}</span></div>`}
function home(){app.innerHTML=`<section class="hero"><div><div class="eyebrow">RPG educativo · Una aventura de virtudes</div><h1>La luz comienza<br>en tu <em style="color:var(--gold)">corazón.</em></h1><p class="muted">BATALLA CONTRA LOS PECADOS CAPITALES</p><p>Siete enemigos. Siete virtudes. Una batalla que comienza en el corazón. Explora un reino perdido y recupera sus siete gemas.</p><div class="row">${btn('Nueva aventura →','create()','primary')}${load()?btn('Continuar','s=load();map()'):''}</div><p style="margin-top:22px"><small>7 regiones · 4 guardianes · Tu propia historia</small></p></div><div class="art" aria-hidden="true"><div class="ring"></div><div class="sigil">♜</div>${Array.from({length:7},(_,i)=>`<span class="star" style="--x:${Math.cos(i*6.28/7)*135-12}px;--y:${Math.sin(i*6.28/7)*135-20}px">◈</span>`).join('')}</div></section><footer>${btn('Créditos y propósito','credits()')}<p>Educación Religiosa · 3.º de secundaria · Sin cuentas ni datos personales.</p></footer>`}
function credits(){modal('<h2>Aprender a elegir</h2><p>Aventura basada en el documento de referencia proporcionado por el usuario. Contenido cristiano educativo: los siete pecados capitales y la práctica de virtudes opuestas. Los combates son simbólicos; los puntos no califican la fe ni el valor de una persona.</p><p>Referencias para el aula: Catecismo 1866 y Romanos 12,21. La gratitud acompaña a la caridad; el respeto y el dominio de sí acompañan a la castidad. La templanza también se ejercita ante otros excesos.</p><p>Gráficos tipográficos y sonidos sintetizados. El alias y el compromiso se guardan únicamente en este navegador; evita datos personales.</p>')}
function create(){app.innerHTML=`<div class="narrow"><div class="eyebrow">Antes de cruzar el portal</div><h2>Elige tu guardián</h2><label>Tu alias<input id="alias" maxlength="24" placeholder="Guardián" autocomplete="off"></label><div class="grid">${heroes.map((h,i)=>`<button class="card" onclick="start(${i})"><span style="font-size:38px;color:var(--gold)">${h[1]}</span><h3>${h[0]}</h3><small>${h[2]}</small></button>`).join('')}</div><footer>Elegir un guardián inicia una partida nueva y sustituye el progreso anterior.</footer>${btn('Volver','home()')}</div>`}
function start(hero){s={name:document.querySelector('#alias').value.trim()||'Guardián',hero,hearts:3,energy:100,points:0,coins:0,gems:[],potions:0,hope:false,correct:0};save();map()}
function map(){save();app.innerHTML=stats()+`<div class="row" style="justify-content:space-between"><div><div class="eyebrow">El Reino del Corazón</div><h2>Siete caminos hacia la luz</h2></div>${btn('Mis logros','achievements()')}</div><p class="muted">${s.gems.length===7?'El espejo del corazón te espera.':'Recupera las gemas para abrir el siguiente territorio.'}</p><div class="grid">${worlds.map((w,i)=>`<button class="card region ${s.gems.includes(i)?'done':i===s.gems.length?'available':''}" ${i>s.gems.length?'disabled':''} onclick="enter(${i})"><small>REGIÓN 0${i+1} · ${s.gems.includes(i)?'✓ COMPLETADA':i===s.gems.length?'DISPONIBLE':'BLOQUEADA'}</small>${regionImage(i)}<strong>${esc(regionContent(i).title)}</strong><small>${esc(regionContent(i).text)}</small></button>`).join('')}<button class="card region" ${s.gems.length<7?'disabled':''} onclick="finalScene()"><span class="icon">✧</span><strong>El Espejo del Corazón</strong><small>${s.gems.length<7?'Reúne las siete gemas':'Tu última misión →'}</small></button></div><footer class="row">${btn('Comprar corazón · 20 ◉','buy()')}${btn('Inicio','home()')}${btn('Reiniciar progreso','resetAsk()')}</footer>`}
function buy(){if(s.coins<20||s.hearts>=5){modal('<p>Necesitas 20 monedas y tener menos de 5 corazones.</p>');return}s.coins-=20;s.hearts++;save();map()}
function resetAsk(){modal('<h2>¿Empezar de nuevo?</h2><p>Se borrará la partida guardada en este navegador.</p>'+btn('Borrar progreso',"localStorage.removeItem(KEY);s=null;document.querySelector('dialog').close();home()"))}
function achievements(){modal(`<h2>Tus logros</h2><p>✦ ${s.points} puntos · ${s.correct} respuestas acertadas</p>${s.gems.map(i=>`<p>◈ Guardián de ${worlds[i].virtue}</p>`).join('')||'<p>Aún no tienes gemas. Tu primer camino está abierto.</p>'}${s.commitment?`<p><strong>${esc(s.finalVirtue)}</strong><br>${esc(s.commitment)}</p>`:''}`)}
function enter(i){level=i;stage=0;hp=300;used=false;shield=false;s.energy=100;if(s.hearts<=0)s.hearts=3;save();scene()}
function scene(){const w=worlds[level];app.innerHTML=stats()+`<div class="eyebrow">Región ${level+1} / 7 · ${w.sin}</div><h2>${esc(regionContent(level).title)}</h2><div class="trail">${[0,1,2,3].map(i=>`<span class="${i<=stage?'lit':''}"></span>`).join('')}</div><div class="split"><section class="card">${regionImage(level,true)}<h3>Una gema espera tu ayuda</h3><p style="white-space:pre-line">${esc(regionContent(level).description)}</p><p class="muted">${stage===0?'La guía del reino te ofrece un mapa: escuchar, elegir y actuar. Cada encuentro enciende un faro hacia el jefe.':stage===1?'Un habitante necesita tu ayuda. Una decisión concreta abrirá el sendero.':'Los faros están encendidos. Abre el cofre y prepara tu encuentro con el jefe.'}</p></section><section class="card"><div class="eyebrow">Explora · Encuentro ${stage+1} de 3</div><h3>${['El sendero roto','La voz del pueblo','El cofre de luz'][stage]}</h3><p>${['Reconstruye el camino ordenando tres acciones.','Escucha una situación y decide cómo ayudar.','Recoge una ayuda y descubre la debilidad del jefe.'][stage]}</p>${btn(['Reconstruir el camino','Escuchar al habitante','Abrir el cofre'][stage],['order()','decision()','chest()'][stage],'primary')}</section></div><footer>${btn('Volver al mapa','map()')}</footer>`}
function order(){chosen=[];renderOrder()}
function moveStep(i,d){const j=i+d;if(j<0||j>=chosen.length)return;[chosen[i],chosen[j]]=[chosen[j],chosen[i]];renderOrder()}
function renderOrder(){const w=regionContent(level);app.innerHTML=stats()+`<div class="narrow card" id="order-activity"><div class="eyebrow">Exploración · Reconstruye el sendero</div><h2>De la intención a la acción</h2><p>Selecciona los tres pasos. Puedes cambiar su posición con las flechas antes de comprobar.</p><div class="feedback">${chosen.map((n,i)=>`<div class="row" style="margin:12px 0"><span style="flex:1">${i+1}. ${esc(w.steps[n])}</span><button aria-label="Subir paso ${i+1}" ${i===0?'disabled':''} onclick="moveStep(${i},-1)">↑</button><button aria-label="Bajar paso ${i+1}" ${i===chosen.length-1?'disabled':''} onclick="moveStep(${i},1)">↓</button></div>`).join('')||'Tu camino comienza aquí…'}</div><div class="options">${[2,0,1].filter(n=>!chosen.includes(n)).map(n=>btn(esc(w.steps[n]),`chosen.push(${n});renderOrder()`)).join('')}</div><div class="row" style="margin-top:20px">${btn('Deshacer','chosen.pop();renderOrder()')}${btn('Empezar de nuevo','order()')}${chosen.length===3?btn('Comprobar camino','checkOrder()','primary'):''}</div><div id="feedback" role="status"></div></div>`}
function completeOrder(){s.points+=15;save();stage=1;scene()}
